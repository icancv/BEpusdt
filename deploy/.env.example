# 已有 PostgreSQL 的连接串（密码含特殊字符需 URL 编码，含 $ 需写成 $$）
POSTGRESQL_DSN=postgres://user:password@postgres:5432/bepusdt?sslmode=disable&connect_timeout=3&timezone=Asia/Shanghai

# 已存在的 docker 网络名（用于访问数据库）
EXTERNAL_NETWORK=your_network

# 宿主机监听地址与端口，公网访问请通过 HTTPS 反向代理转发到此端口
BIND_HOST=127.0.0.1
BEPUSDT_PORT=6188

# 镜像标签
IMAGE_TAG=local
